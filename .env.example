# Hugging Face authentication for the LTX Space
HF_TOKEN=hf_your_token

# Optional Luma Dream Machine API key
LUMAAI_API_KEY=luma_your_api_key

# Remote/local ComfyUI base URL. Leave localhost for a local ComfyUI instance.
COMFYUI_URL=http://127.0.0.1:8188

# Path to a real ComfyUI API-format workflow JSON.
# Example: workflows/comfyui/wan-api.json
COMFYUI_WORKFLOW_PATH=workflows/comfyui/api-workflow.json

# PostgreSQL connection for persistent projects, generations and dataset metadata
DATABASE_URL=postgresql://user:password@host:5432/database
