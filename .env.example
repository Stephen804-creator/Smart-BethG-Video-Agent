# Provider configuration (never store real secrets in this file)
HF_TOKEN=
HF_SPACE=Lightricks/ltx-video-distilled
LUMAAI_API_KEY=
LUMA_MODEL=ray-flash-2
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=

# PostgreSQL connection for persistent projects, generations and dataset metadata
DATABASE_URL=postgresql://user:password@host:5432/database

# Required in production
APP_AUTH_PASSWORD=replace-with-a-long-private-password
APP_SESSION_SECRET=replace-with-a-random-32-byte-secret
APP_ACCESS_TOKEN=
APP_ALLOWED_ORIGINS=https://your-frontend.example.com

# Database security
DATABASE_SSL=true
DATABASE_SSL_CA=

# Local development only; never enable on a deployed service
ALLOW_INSECURE_LOCAL=false
